# =============================================================================
# KARA Dashboard — environment configuration (example / template)
# Copy to .env on the server or locally. Never commit real secrets.
# =============================================================================

# --- Django core ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# DJANGO_ALLOWED_HOSTS=portal.pakhshmarket.com,85.198.10.243
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.pakhshmarket.com

# Paths (production server defaults shown in comments)
# DJANGO_STATIC_ROOT=/var/lib/kara/staticfiles
# DJANGO_MEDIA_ROOT=/var/lib/kara/media
# KARA_LOG_DIR=/var/log/kara
# KARA_CACHE_DIR=/var/lib/kara/cache

# SSL / proxy (Nginx terminates TLS; Gunicorn listens on localhost)
# Phase 1 — before Certbot (HTTP only or Nginx HTTP→HTTPS redirect):
#   DJANGO_SECURE_SSL_REDIRECT=False
# Phase 2 — after Certbot certificate is active:
#   DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_DEBUG=False
# DJANGO_USE_X_FORWARDED_HOST=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_HSTS_SECONDS=31536000

# --- Database ---
# Development default: SQLite (leave POSTGRES_* empty)
# Production: PostgreSQL
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=kara
# POSTGRES_USER=kara
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10

# Optional shared cache for multi-worker sync locks (requires redis package)
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Kara API connection ---
KARA_BASE_URL=http://app.pakhshmarket.com
KARA_USERNAME=
KARA_PASSWORD=

# Optional: paste full Cookie header if login via username/password is unavailable
KARA_COOKIE=

# Paths (defaults point to project root; override only if needed)
KARA_CREDENTIALS_FILE=credentials.txt
KARA_COOKIE_FILE=cookies.txt

# HTTP timeout (seconds) for all Kara API requests
KARA_REQUEST_TIMEOUT=60

# Session recovery / cookie persistence
KARA_SESSION_AUTO_RECOVER=True
KARA_PERSIST_COOKIES=True

# Browser User-Agent sent to Kara
KARA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36

# --- Background sync scheduler ---
# Web (Gunicorn) must NOT run the scheduler — disable in kara-web.service:
# KARA_DISABLE_AUTO_REFRESH=1
# Dedicated scheduler service (kara-scheduler.service):
# KARA_RUN_SCHEDULER=1
# AUTO_REFRESH_ENABLED=True
AUTO_REFRESH_ENABLED=True
AUTO_REFRESH_INTERVAL_MINUTES=5
AUTO_REFRESH_STAGGER_SECONDS=50
KARA_DISABLE_AUTO_REFRESH=0

# --- TV Mode ---
TV_SLIDE_INTERVAL_SECONDS=20
TV_AUTO_REFRESH_SECONDS=60

# --- Display currency (storage stays Rial) ---
# toman | rial
KARA_CURRENCY_UNIT=toman

# --- Database retention (keep live snapshots only) ---
SNAPSHOT_KEEP_FULL=1
SNAPSHOT_KEEP_DAILY=1
SYNC_JOB_RETENTION_DAYS=14
REFRESH_LOG_KEEP=100

# --- Feature flags ---
KARA_FEATURE_PROFITABILITY=False

# --- Bale messenger bot ---
# Web service: BALE_BOT_ENABLED=False
# Bot service (kara-bot.service): BALE_BOT_ENABLED=True
BALE_BOT_TOKEN=
BALE_BOT_ENABLED=False
BALE_CONNECT_TIMEOUT=10
BALE_READ_TIMEOUT=30
# Comma-separated Bale user IDs with admin access to bot management
BALE_ADMIN_IDS=
BALE_LOGIN_MAX_ATTEMPTS=5
BALE_LOGIN_LOCK_MINUTES=15

# --- Optional Kara report filters (from Network dump / API discovery) ---
# Pipe-separated partner group UUIDs for sale_orders (080501)
KARA_SALE_ORDERS_DYNAMIC_PARTNER_GROUPS=

# Comma-separated UUID lists for stuff_group_sale / monthly_sale
KARA_ENTITY_GROUP_IDS=
KARA_PARTNER_GROUP_IDS=
