# =============================================================================
# KARA Dashboard — environment configuration (example / template)
# Copy to .env and fill in secrets. File name for runtime must be: .env
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Kara API connection ---
KARA_BASE_URL=http://app.pakhshmarket.com
KARA_USERNAME=
KARA_PASSWORD=

# Optional: paste full Cookie header if login via username/password is unavailable
KARA_COOKIE=

# Paths (defaults point to project root; override only if needed)
KARA_CREDENTIALS_FILE=credentials.txt
KARA_COOKIE_FILE=cookies.txt

# HTTP timeout (seconds)
KARA_REQUEST_TIMEOUT=60

# Session recovery / cookie persistence
KARA_SESSION_AUTO_RECOVER=True
KARA_PERSIST_COOKIES=True

# Browser User-Agent sent to Kara
KARA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36

# --- Auto refresh (dashboard / background sync) ---
# Each report runs on its own suggested_interval_minutes; stagger avoids
# concurrent Kara DB pressure. AUTO_REFRESH_INTERVAL_MINUTES is the UI pulse
# / primary-KPI stale threshold.
AUTO_REFRESH_ENABLED=True
AUTO_REFRESH_INTERVAL_MINUTES=5
AUTO_REFRESH_STAGGER_SECONDS=50
# Set to 1 to disable in-process scheduler (useful for tests / manage.py)
KARA_DISABLE_AUTO_REFRESH=0

# --- TV Mode ---
TV_SLIDE_INTERVAL_SECONDS=20
TV_AUTO_REFRESH_SECONDS=60

# --- Display currency (storage stays Rial) ---
# toman | rial
KARA_CURRENCY_UNIT=toman

# --- Database retention (keep live snapshots only) ---
SNAPSHOT_KEEP_FULL=1
SNAPSHOT_KEEP_DAILY=1
SYNC_JOB_RETENTION_DAYS=14
REFRESH_LOG_KEEP=100

# --- Feature flags ---
KARA_FEATURE_PROFITABILITY=False

# --- Bale messenger bot ---
BALE_BOT_TOKEN=
BALE_BOT_ENABLED=False
# Comma-separated Bale user IDs with admin access to bot management
BALE_ADMIN_IDS=
BALE_LOGIN_MAX_ATTEMPTS=5
BALE_LOGIN_LOCK_MINUTES=15

# --- Optional Kara report filters (from Network dump / API discovery) ---
# Pipe-separated partner group UUIDs for sale_orders (080501)
KARA_SALE_ORDERS_DYNAMIC_PARTNER_GROUPS=

# Comma-separated UUID lists for stuff_group_sale / monthly_sale
KARA_ENTITY_GROUP_IDS=
KARA_PARTNER_GROUP_IDS=
